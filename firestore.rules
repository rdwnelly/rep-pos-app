rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Peran dibaca dari custom claim pada ID token: 0 document read,
    // jadi jauh lebih murah dan cepat dibanding get() per operasi.
    // Fallback ke dokumen users/{uid} dipertahankan supaya akun yang
    // claim-nya belum di-backfill (mis. user baru dari menu Pengaturan)
    // tetap bisa bekerja. Hapus fallback ini setelah semua akun
    // punya claim dan pembuatan user sudah lewat /api/admin/set-role.
    function getUserRole() {
      return 'role' in request.auth.token
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getUserRole() in ['SUPERADMIN', 'OWNER', 'ADMIN'];
    }

    function isOwnerUp() {
      return getUserRole() in ['SUPERADMIN', 'OWNER'];
    }

    function isCashier() {
      return getUserRole() == 'CASHIER';
    }

    function isWarehouse() {
      return getUserRole() == 'GUDANG';
    }

    // ─── Users Collection ────────────────────────────────────────
    // Setiap user login bisa baca data dirinya sendiri.
    // Hanya SUPERADMIN yang bisa baca semua user.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'SUPERADMIN');

      // Password dikelola sepenuhnya oleh Firebase Auth. Menyimpan
      // password (plaintext maupun hash) di dokumen Firestore tidak
      // ada gunanya dan menjadi kebocoran kredensial, jadi ditolak.
      allow write: if isAuthenticated()
                   && getUserRole() == 'SUPERADMIN'
                   && !('password' in request.resource.data);
    }

    // ─── Store Settings ──────────────────────────────────────────
    match /store_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ─── Products ────────────────────────────────────────────────
    // Semua user bisa baca produk.
    // Hanya Admin/Gudang yang bisa create/delete produk.
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || isWarehouse())
                    && request.resource.data.get('stock', 0) >= 0;
      allow delete: if isAuthenticated() && (isAdmin() || isWarehouse());

      /**
       * Stok tidak boleh berakhir negatif.
       *
       * Seluruh perubahan stok di aplikasi memakai increment() di dalam
       * batch, tanpa membaca stok lebih dulu. Pengecekan di POS hanya
       * melindungi satu perangkat: dua kasir yang menjual barang terakhir
       * pada saat bersamaan sama-sama lolos, dan stok berakhir minus
       * tanpa ada yang menolak. Hanya server yang bisa menengahi balapan
       * itu, jadi penjaganya harus di sini.
       *
       * Aturan Firestore memang melihat HASIL dari increment(), bukan
       * nilai lamanya — diverifikasi di emulator, lihat
       * tests/rules-stok.mjs.
       *
       * Syarat keduanya penting: dokumen yang stoknya terlanjur minus
       * akibat bug lama akan tertolak pada setiap update kalau hanya
       * dicek ">= 0", sehingga tidak bisa diperbaiki lagi. Menaikkan
       * stok selalu diizinkan, termasuk dari -5 ke -2.
       */
      function stokTidakBerakhirMinus() {
        return request.resource.data.get('stock', 0) >= 0
               || request.resource.data.get('stock', 0) >= resource.data.get('stock', 0);
      }

      // Admin/Gudang boleh mengubah data master apa pun.
      // Peran lain (kasir) HANYA boleh menyentuh field 'stock', karena
      // itulah satu-satunya yang perlu berubah saat transaksi berjalan.
      // Tanpa batasan ini kasir bisa mengubah price dan hpp lewat SDK.
      allow update: if isAuthenticated()
                    && stokTidakBerakhirMinus()
                    && (
                      isAdmin()
                      || isWarehouse()
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                    );
    }

    // ─── Categories ──────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ─── Divisions ───────────────────────────────────────────────
    match /divisions/{divisionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ─── Customers ───────────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && !isWarehouse();
    }

    // ─── Suppliers ───────────────────────────────────────────────
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ─── Banks ───────────────────────────────────────────────────
    match /banks/{bankId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ─── Transactions ────────────────────────────────────────────
    match /transactions/{transactionId} {

      function incoming() {
        return request.resource.data;
      }

      function isReturn() {
        return incoming().get('type', 'SALE') == 'RETURN';
      }

      // Field wajib ada — hanya ditegakkan saat create, supaya dokumen
      // lama yang dibuat sebelum validasi ini ada tetap bisa di-update
      // (mis. pelunasan piutang atas transaksi tahun lalu).
      function hasRequiredKeys() {
        return incoming().keys().hasAll([
                 'date', 'items', 'totalAmount', 'amountPaid',
                 'paymentStatus', 'paymentMethod', 'customerName',
                 'cashierId', 'cashierName'
               ]);
      }

      // Tipe data harus benar. Ini menutup angka yang dikirim sebagai
      // string, yang membuat laporan keuangan salah jumlah tanpa error.
      // Semua akses lewat get() dengan default agar dokumen lama yang
      // field-nya tidak lengkap tidak langsung menggagalkan evaluasi.
      function hasValidTypes() {
        return incoming().get('items', []) is list
               && incoming().get('items', []).size() > 0
               && incoming().get('totalAmount', 0) is number
               && incoming().get('amountPaid', 0) is number
               && incoming().get('change', 0) is number
               && incoming().get('date', '') is string
               && incoming().get('cashierId', '') is string
               && incoming().get('customerName', '') is string
               && incoming().get('paymentStatus', 'LUNAS') in ['LUNAS', 'SEBAGIAN', 'BELUM_LUNAS']
               && incoming().get('paymentMethod', 'CASH') in ['CASH', 'TRANSFER', 'TEMPO', 'BON', 'QRIS'];
      }

      // Penjualan tidak boleh bertotal negatif; retur justru harus
      // negatif karena dipakai untuk membalik nilai penjualan.
      function hasValidSign() {
        return isReturn()
               ? incoming().totalAmount <= 0
               : incoming().totalAmount >= 0;
      }

      // Konsistensi diskon, hanya diperiksa bila subtotal dikirim
      // (POS penjualan normal tidak mengirim subtotal; Backdate dan
      // Reopen mengirimnya).
      function hasConsistentDiscount() {
        return !('subtotal' in incoming())
               || (
                 incoming().subtotal is number
                 && incoming().get('discountAmount', 0) is number
                 && incoming().get('discountAmount', 0) >= 0
                 && incoming().get('discountAmount', 0) <= incoming().subtotal
                 && incoming().totalAmount == incoming().subtotal - incoming().get('discountAmount', 0)
               );
      }

      // Kembalian harus benar-benar selisih bayar dengan total.
      // HANYA untuk create: pada update angsuran, 'change' sengaja
      // dihitung terhadap sisa utang, bukan terhadap total.
      function hasConsistentChange() {
        return incoming().get('change', 0) == incoming().amountPaid - incoming().totalAmount;
      }

      // Kasir tidak boleh mengatribusikan transaksi ke orang lain.
      // Admin ke atas boleh, karena perlu untuk input susulan/backdate.
      function isAttributedToSelf() {
        return incoming().cashierId == request.auth.uid;
      }

      // Baca dibuka untuk semua yang login.
      //
      // Membatasinya ke transaksi milik sendiri terdengar aman, tapi
      // tidak cocok dengan cara aplikasi ini dipakai: BERITA ACARA
      // REKAPITULASI KEUANGAN & TUTUP BUKU — juga Laporan Setoran Sesi
      // harian — memang merekap penjualan SELURUH toko, dan dibuka oleh
      // petugas yang berjaga, bukan hanya Admin. Dengan batasan itu,
      // rekapitulasi, pemasukan tunai/non-tunai, piutang, dan laba
      // bersih tampil kosong bagi peran selain admin.
      //
      // Batasan itu juga tidak pernah benar-benar menahan apa pun:
      // layarnya tetap menampilkan rekap seluruh toko kepada mereka.
      // Yang tetap dijaga ketat adalah TULISNYA — kasir tidak bisa
      // membuat atau mengubah transaksi atas nama orang lain (lihat
      // isAttributedToSelf dan aturan update di bawah).
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && hasRequiredKeys()
                    && hasValidTypes()
                    && hasValidSign()
                    && hasConsistentDiscount()
                    && hasConsistentChange()
                    && (isAdmin() || isAttributedToSelf());

      // Update dipakai untuk angsuran, retur, dan reopen. Bentuk dan
      // tanda tetap divalidasi, tapi identitas kasir, tanggal, dan
      // jenis transaksi tidak boleh digeser oleh non-admin — itu
      // yang menjaga jejak audit tetap utuh.
      allow update: if isAuthenticated()
                    && (isAdmin() || resource.data.cashierId == request.auth.uid)
                    && hasValidTypes()
                    && hasValidSign()
                    && hasConsistentDiscount()
                    && (
                      isAdmin()
                      || (
                        incoming().cashierId == resource.data.cashierId
                        && incoming().date == resource.data.date
                        && incoming().get('type', 'SALE') == resource.data.get('type', 'SALE')
                      )
                    );

      allow delete: if isAuthenticated() && isOwnerUp();
    }

    // ─── Purchases ───────────────────────────────────────────────
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && !isCashier();
      allow delete: if isAuthenticated() && isOwnerUp();
    }

    // ─── Cash Flow ───────────────────────────────────────────────
    match /cashflow/{cashflowId} {

      // Catatan kas yang dialirkan dari "Rincian Pengeluaran
      // Operasional" Berita Acara harian. Petugas yang mencatatnya
      // harus bisa mengoreksi dan menghapus barisnya sendiri, karena
      // di modul itu rincian pengeluaran memang diedit berulang kali
      // sepanjang hari sebelum tutup buku. Lihat
      // services/beritaAcaraExpenseSync.ts.
      function isBeritaAcaraEntry() {
        return resource.data.get('source', '') == 'BERITA_ACARA';
      }

      function isOwnBeritaAcaraEntry() {
        return isBeritaAcaraEntry()
               && resource.data.get('userId', '') == request.auth.uid;
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || isOwnBeritaAcaraEntry());

      // Penghapusan catatan kas pada umumnya tetap hak OWNER ke atas.
      // Pengecualiannya catatan bersumber Berita Acara: baris itu
      // cuma cerminan arsip harian, dan ketika barisnya dihapus di
      // modul Berita Acara, cerminannya WAJIB bisa ikut terhapus —
      // kalau tidak, nominalnya tertinggal dan beban operasional di
      // Tutup Buku jadi lebih besar dari kenyataan. Admin (pengelola
      // buku kas) dan petugas pencatatnya sendiri yang boleh.
      allow delete: if isAuthenticated()
                    && (isOwnerUp()
                        || (isBeritaAcaraEntry() && (isAdmin() || isOwnBeritaAcaraEntry())));
    }

    // ─── Stock Adjustments ───────────────────────────────────────
    // Pengecekan Stok (opname) tersedia di menu semua peran, dan
    // petugas yang berjaga itulah yang menghitung fisiknya. Sebelumnya
    // create/delete dibatasi Admin & Gudang, sehingga kasir menekan
    // simpan lalu kena "Missing or insufficient permissions" — menu
    // terbuka tapi tulisannya ditolak.
    //
    // Nilai kerugian/selisih opname tetap terlihat di Laporan Bulanan
    // (lihat stockAdjustmentMetrics), jadi koreksi yang salah masih
    // bisa ditelusuri dan dibersihkan.
    match /stock_adjustments/{adjustmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ─── Berita Acara Archives ───────────────────────────────────
    // "Berita Acara & Laporan Setoran Sesi" adalah modul HARIAN KASIR:
    // petugas yang berjaga mengisi rekap penjualan, rincian pengeluaran
    // operasional, dan setoran fisiknya sepanjang sesi, dan halaman itu
    // menyimpan otomatis setiap kali ada perubahan.
    //
    // Sebelumnya tulis dibatasi isAdmin(), sehingga auto-save SELALU
    // gagal untuk akun kasir ("Auto save archive error: Missing or
    // insufficient permissions") — modul inti kasir praktis tidak bisa
    // menyimpan apa pun ke cloud.
    match /berita_acara_archives/{archiveId} {

      function archive() {
        return request.resource.data;
      }

      function hasValidArchive() {
        return archive().keys().hasAll(['date'])
               && archive().date is string
               && archive().date.size() > 0;
      }

      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && hasValidArchive();

      // Tanggal arsip tidak boleh digeser oleh non-admin: itu yang
      // menjaga rekap satu hari tetap milik hari itu.
      allow update: if isAuthenticated()
                    && hasValidArchive()
                    && (isAdmin()
                        || archive().date == resource.data.get('date', archive().date));

      allow delete: if isAuthenticated() && isAdmin();
    }

    // ─── Akun Biaya Berita Acara ─────────────────────────────────
    // Satu dokumen "default" berisi array terurut. Urutannya bermakna:
    // nomor di depan tiap akun ikut tercetak di dokumen setoran.
    //
    // Sebelumnya daftar ini hanya ada di localStorage tiap perangkat,
    // jadi akun biaya di HP satu karyawan berbeda dengan di HP yang
    // lain — dan rekap yang dikirim ke SIK-REP tidak bisa dibandingkan.
    match /expense_accounts/{docId} {
      allow read: if isAuthenticated();

      // Gudang tidak mengerjakan setoran, jadi tidak perlu mengubah
      // daftar akun biaya. Peran lain boleh, karena menambah akun baru
      // adalah hal yang wajar dilakukan kasir di tengah sesi.
      allow write: if isAuthenticated()
                   && !isWarehouse()
                   && request.resource.data.options is list;
    }

    // ─── Open Bills ──────────────────────────────────────────────
    match /open_bills/{billId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ─── Travel Agents ───────────────────────────────────────────
    match /travel_agents/{agentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ─── Tiket SSO PORTAL REP ────────────────────────────────────
    // Hanya dikelola server (Admin SDK). Klien tidak boleh membaca tiket.
    match /portal_sso_tickets/{ticketId} {
      allow read, write: if false;
    }

    // ─── Data Pengunjung Wisatawan ───────────────────────────────
    // Dipakai untuk pelaporan kunjungan, sehingga nilainya harus
    // konsisten sejak ditulis. Validasi di sini menolak data yang
    // jumlah dewasa dan anaknya tidak cocok dengan total pengunjung.
    match /visitor_logs/{logId} {

      function visitor() {
        return request.resource.data;
      }

      function hasValidVisitorData() {
        return visitor().keys().hasAll([
                 'date', 'originType', 'originRegion', 'segment',
                 'paxTotal', 'paxAdult', 'paxChild',
                 'recordedById', 'recordedByName'
               ])
               && visitor().date is string
               && visitor().originType in ['NUSANTARA', 'MANCANEGARA']
               && visitor().originRegion is string
               && visitor().originRegion.size() > 0
               && visitor().segment in ['UMUM', 'KELUARGA', 'PELAJAR', 'INSTANSI', 'KOMUNITAS']
               && visitor().paxTotal is int
               && visitor().paxTotal > 0
               && visitor().paxAdult is int
               && visitor().paxAdult >= 0
               && visitor().paxChild is int
               && visitor().paxChild >= 0
               // Rincian wajib menjumlah tepat ke total pengunjung.
               && visitor().paxAdult + visitor().paxChild == visitor().paxTotal
               // Kanal pemesanan opsional, tapi nilainya harus dikenal.
               && visitor().get('bookingChannel', 'LANGSUNG') in ['LANGSUNG', 'TRAVEL_AGENT', 'OTA']
               // Pemesanan lewat OTA wajib menyebutkan platformnya,
               // karena tanpa itu rekap kanal tidak bisa ditelusuri.
               && (visitor().get('bookingChannel', 'LANGSUNG') != 'OTA'
                   || (visitor().get('otaName', '') is string && visitor().get('otaName', '').size() > 0));
      }

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && hasValidVisitorData()
                    && visitor().recordedById == request.auth.uid;

      // Koreksi hanya oleh admin atau oleh petugas yang mencatatnya.
      allow update: if isAuthenticated()
                    && hasValidVisitorData()
                    && (isAdmin() || resource.data.recordedById == request.auth.uid);

      // Data Pengunjung tersedia untuk semua peran, termasuk tombol
      // hapusnya. Membatasi hapus ke Admin membuat tombol itu selalu
      // gagal bagi petugas yang mencatat, jadi dibuka seperti create
      // dan update-nya.
      allow delete: if isAuthenticated();
    }

    // ─── Travel Commissions ──────────────────────────────────────
    match /travel_commissions/{commissionId} {
      allow read: if isAuthenticated();

      // Create dibuka untuk semua peran karena Kasir (POS) kini bisa
      // dipakai peran apa pun, dan checkout dengan agen travel otomatis
      // menulis komisinya. Tanpa ini, transaksi beragen gagal di tengah
      // jalan untuk peran GUDANG.
      allow create: if isAuthenticated();

      // Koreksi dan pelunasan komisi tetap bukan pekerjaan Gudang.
      allow update, delete: if isAuthenticated() && !isWarehouse();
    }
  }
}
